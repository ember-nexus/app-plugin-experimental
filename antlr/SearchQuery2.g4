grammar SearchQuery2;

MINUS
   : '-'
   ;

EXCLAMATION_MARK
   : '!'
   ;

HEX_DIGIT
   : [0-9A-Fa-f]
   ;

UUID
   : HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT MINUS
     HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT MINUS
     HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT MINUS
     HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT MINUS
     HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT
   ;



searchQuery
   : bang? UUID EOF
   ;

bang
   : bangIdentifier
   ;

bangIdentifier
   : EXCLAMATION_MARK
   ;
